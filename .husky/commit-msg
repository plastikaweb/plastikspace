npx --no -- commitlint --edit ${1}

# --- COMMIT REFERENCES (META-22) ---
# What commitlint cannot see: the branch's ClickUp ID in the header, a task ID when eco
# code is staged, and a CHANGELOG.md bullet on the branch for a feat, fix or perf with code.
# Hooks run from the main checkout's .husky, so a checkout on a branch that predates the
# script commits without these three checks.
if [ -f tools/scripts/check-commit-refs.cjs ]; then
  node tools/scripts/check-commit-refs.cjs "$1"
else
  echo "ℹ️  This branch has no tools/scripts/check-commit-refs.cjs (it predates META-22): ClickUp ID,"
  echo "   task ID and CHANGELOG bullet not checked."
fi
