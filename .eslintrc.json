{
  "root": true,
  "ignorePatterns": ["**/*"],
  "plugins": ["@nx", "deprecation", "jsdoc", "@angular-eslint"],
  "parserOptions": {
    "project": ["./tsconfig.base.json", "./tsconfig.eslint.json"]
  },
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx", "*.mts", "*.cts"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": [],
            "depConstraints": [
              {
                "sourceTag": "*",
                "onlyDependOnLibsWithTags": ["*"]
              },
              {
                "sourceTag": "type:app",
                "onlyDependOnLibsWithTags": [
                  "type:feature",
                  "type:ui",
                  "type:util",
                  "type:data-access",
                  "type:entity",
                  "scope:core",
                  "scope:shared"
                ]
              },
              {
                "sourceTag": "scope:core",
                "onlyDependOnLibsWithTags": [
                  "scope:core",
                  "type:entity",
                  "type:util",
                  "scope:shared"
                ]
              },
              {
                "sourceTag": "scope:shared",
                "onlyDependOnLibsWithTags": ["scope:shared", "type:entity", "type:util"]
              },
              {
                "sourceTag": "scope:nasa-images",
                "onlyDependOnLibsWithTags": ["scope:nasa-images", "scope:core", "scope:shared"]
              },
              {
                "sourceTag": "scope:llecoop",
                "onlyDependOnLibsWithTags": ["scope:llecoop", "scope:core", "scope:shared"]
              },
              {
                "sourceTag": "scope:plastikaweb",
                "onlyDependOnLibsWithTags": ["scope:plastikaweb", "scope:core", "scope:shared"]
              },
              {
                "sourceTag": "scope:eco-store",
                "onlyDependOnLibsWithTags": ["scope:eco-store", "scope:core", "scope:shared"]
              },
              {
                "sourceTag": "type:feature",
                "onlyDependOnLibsWithTags": [
                  "type:ui",
                  "type:util",
                  "type:data-access",
                  "type:entity",
                  "type:feature"
                ]
              },
              {
                "sourceTag": "type:ui",
                "onlyDependOnLibsWithTags": ["type:entity", "type:ui", "type:util"]
              },
              {
                "sourceTag": "type:util",
                "onlyDependOnLibsWithTags": ["type:util", "type:entity"]
              },
              {
                "sourceTag": "type:entity",
                "onlyDependOnLibsWithTags": ["type:entity", "type:util"]
              },
              {
                "sourceTag": "type:data-access",
                "onlyDependOnLibsWithTags": ["type:util", "type:entity", "type:data-access"]
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.spec.ts", "*.spec.tsx", "*.spec.js", "*.spec.jsx", "*.spec.mts", "*.spec.cts"],
      "env": {
        "jest": true
      },
      "parserOptions": {
        "project": null
      },
      "rules": {
        "deprecation/deprecation": "off"
      }
    },
    {
      "files": ["*.ts", "*.tsx", "*.mts", "*.cts"],
      "excludedFiles": ["*.spec.ts", "*.spec.tsx", "*.spec.mts", "*.spec.cts"],
      "extends": ["plugin:@nx/typescript"],
      "rules": {
        "no-console": "error",
        "@typescript-eslint/prefer-readonly": "error",
        "no-extra-semi": "off"
      }
    },
    {
      "files": ["*.ts", "*.mts", "*.cts"],
      "extends": ["plugin:ngrx/recommended"],
      "rules": {
        "ngrx/select-style": "error"
      }
    },
    {
      "files": ["*.js", "*.jsx"],
      "extends": ["plugin:@nx/javascript"],
      "rules": {
        "no-extra-semi": "off"
      }
    },
    {
      "files": ["*.ts", "*.tsx", "*.mts", "*.cts"],
      "excludedFiles": ["*.spec.ts", "*.spec.tsx", "*.spec.mts", "*.spec.cts"],
      "rules": {
        "deprecation/deprecation": "warn"
      }
    },
    {
      "files": ["*.ts", "*.tsx", "*.mts", "*.cts"],
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint"],
      "rules": {
        "id-length": [
          "warn",
          {
            "min": 2,
            "max": 40,
            "exceptions": ["i", "j", "x", "y", "k", "v", "m", "e", "t", "_", "id", "db", "fs"]
          }
        ],
        "id-denylist": ["warn", "data", "info", "temp", "val", "item", "foo", "bar", "baz"],
        "no-restricted-syntax": [
          "error",
          {
            "selector": "ClassProperty[accessibility='private']",
            "message": "Use ES6 private fields (#) instead of the private modifier."
          }
        ],
        "@typescript-eslint/member-ordering": [
          "error",
          {
            "default": ["signature", "field", "constructor", "method"]
          }
        ],
        "@typescript-eslint/naming-convention": [
          "warn",
          {
            "selector": "default",
            "format": ["camelCase"],
            "leadingUnderscore": "allow",
            "trailingUnderscore": "allow"
          },
          {
            "selector": "variable",
            "format": ["camelCase", "UPPER_CASE", "PascalCase"],
            "leadingUnderscore": "allow",
            "trailingUnderscore": "allow"
          },
          {
            "selector": "import",
            "format": ["camelCase", "PascalCase", "UPPER_CASE"]
          },
          {
            "selector": "variable",
            "types": ["boolean"],
            "format": ["PascalCase"],
            "prefix": ["is", "has", "can", "should", "will"]
          },
          {
            "selector": "typeLike",
            "format": ["PascalCase"]
          },
          {
            "selector": "enumMember",
            "format": ["PascalCase", "UPPER_CASE"]
          },
          {
            "selector": "property",
            "format": null
          },
          {
            "selector": "parameter",
            "format": ["camelCase"],
            "leadingUnderscore": "allow"
          }
        ],
        "padding-line-between-statements": [
          "warn",
          {
            "blankLine": "always",
            "prev": "*",
            "next": "return"
          },
          {
            "blankLine": "always",
            "prev": ["const", "let", "var"],
            "next": "*"
          },
          {
            "blankLine": "any",
            "prev": ["const", "let", "var"],
            "next": ["const", "let", "var"]
          }
        ]
      }
    },
    {
      "files": ["*.ts", "*.tsx", "*.mts", "*.cts"],
      "extends": ["plugin:jsdoc/recommended"],
      "rules": {
        "jsdoc/match-description": [
          "error",
          {
            "matchDescription": "/^[A-Z].+[.]/"
          }
        ]
      }
    },
    {
      "files": ["*.html"],
      "extends": [
        "plugin:@angular-eslint/template/recommended",
        "plugin:@angular-eslint/template/accessibility"
      ],
      "rules": {
        "@angular-eslint/template/no-positive-tabindex": "error",
        "@angular-eslint/template/alt-text": "error",
        "@angular-eslint/template/click-events-have-key-events": "error",
        "@angular-eslint/template/elements-content": "error",
        "@angular-eslint/template/interactive-supports-focus": "error",
        "@angular-eslint/template/label-has-associated-control": "error",
        "@angular-eslint/template/mouse-events-have-key-events": "error",
        "@angular-eslint/template/no-autofocus": "error",
        "@angular-eslint/template/role-has-required-aria": "error",
        "@angular-eslint/template/table-scope": "error",
        "@angular-eslint/template/valid-aria": "error",
        "@angular-eslint/template/no-any": "error",
        "@angular-eslint/template/no-duplicate-attributes": "error",
        "@angular-eslint/no-input-prefix": "error",
        "@angular-eslint/use-lifecycle-interface": "error",
        "@angular-eslint/prefer-output-readonly": "error",
        "@angular-eslint/component-max-inline-declarations": "error",
        "@angular-eslint/template/use-track-by-function": "error",
        "@angular-eslint/use-pipe-transform-interface": "error",
        "@angular-eslint/no-conflicting-lifecycle": "error",
        "@angular-eslint/relative-url-prefix": "error",
        "@angular-eslint/use-component-selector": "error",
        "@angular-eslint/template/conditional-complexity": "error",
        "@angular-eslint/use-injectable-provided-in": "error",
        "@angular-eslint/no-inputs-metadata-property": "error",
        "@angular-eslint/no-outputs-metadata-property": "error",
        "@angular-eslint/no-queries-metadata-property": "error",
        "@angular-eslint/template/no-distracting-elements": "error",
        "@angular-eslint/component-class-suffix": "error",
        "@angular-eslint/no-empty-lifecycle-method": "error",
        "@angular-eslint/template/attributes-order": "error",
        "@angular-eslint/template/banana-in-box": "error",
        "@angular-eslint/template/eqeqeq": "error",
        "@angular-eslint/template/no-interpolation-in-attributes": "error",
        "@angular-eslint/template/no-negated-async": "error"
      }
    },
    {
      "files": ["*.json", "*.jsonc", "*.webmanifest"],
      "parser": "jsonc-eslint-parser",
      "rules": {}
    },
    {
      "files": ["*.spec.ts", "*.spec.tsx", "*.spec.mts", "*.spec.cts"],
      "rules": {
        "@typescript-eslint/naming-convention": [
          "warn",
          {
            "selector": "default",
            "format": ["camelCase"],
            "leadingUnderscore": "allow",
            "trailingUnderscore": "allow"
          },
          {
            "selector": "variable",
            "format": ["camelCase", "UPPER_CASE", "PascalCase"],
            "leadingUnderscore": "allow",
            "trailingUnderscore": "allow"
          },
          {
            "selector": "import",
            "format": ["camelCase", "PascalCase", "UPPER_CASE"]
          },
          {
            "selector": "typeLike",
            "format": ["PascalCase"]
          },
          {
            "selector": "enumMember",
            "format": ["PascalCase", "UPPER_CASE"]
          },
          {
            "selector": "property",
            "format": null
          },
          {
            "selector": "parameter",
            "format": ["camelCase"],
            "leadingUnderscore": "allow"
          }
        ]
      }
    }
  ]
}
