{
  "defaults": {
    "timeout": 120000,
    "concurrency": 1,
    "standard": "WCAG2AA",
    "viewport": {
      "width": 320,
      "height": 480
    },
    "reporters": [
      "cli",
      [
        "json",
        {
          "fileName": "./apps/eco-admin/.pa11y-report.json"
        }
      ]
    ],
    "ignore": ["notice", "warning"],
    "chromeLaunchConfig": {
      "args": ["--no-sandbox"]
    }
  },
  "urls": [
    "http://localhost:8080/",
    "http://localhost:8080/accedir",
    {
      "url": "http://localhost:8080/#axe",
      "runners": ["axe"],
      "rules": ["target-size"],
      "ignore": ["notice", "warning", "color-contrast"]
    },
    {
      "url": "http://localhost:8080/accedir#axe",
      "runners": ["axe"],
      "rules": ["target-size"],
      "ignore": ["notice", "warning", "color-contrast"]
    }
  ]
}
